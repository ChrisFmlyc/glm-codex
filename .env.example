# Copy this file to .env.
# You only need to fill in TWO values: GLM_BASE_URL and GLM_API_KEY.
# Everything else has a working default or is generated for you.
# .env is gitignored - never commit it.

# ---- your GLM endpoint -------------------------------------------------
# The OpenAI-compatible base URL. Must end in /v1
# RunPod example: https://<POD_ID>-8000.proxy.runpod.net/v1
# Local vLLM example: http://localhost:8000/v1
GLM_BASE_URL=https://YOUR-POD-ID-8000.proxy.runpod.net/v1

# The API key your endpoint expects (vLLM --api-key).
GLM_API_KEY=REPLACE_WITH_YOUR_ENDPOINT_KEY

# ---- local proxy -------------------------------------------------------
# LEAVE THIS ALONE. start-proxy generates it on first run and writes it back
# here. It only authenticates Claude Code to the proxy on your own machine -
# it never leaves your computer and is not shared with anyone.
LITELLM_MASTER_KEY=sk-local-REPLACE_ME

# ---- context window ----------------------------------------------------
# Must match your server's --max-model-len exactly.
GLM_MAX_CONTEXT=1048576
GLM_MAX_OUTPUT=16384

# Port for the local proxy (Claude Code path only).
LITELLM_PORT=4000

# The served model name, must match your server's --served-model-name.
# Used by both the Claude Code and Codex paths.
GLM_MODEL_NAME=glm53-uncensored

# ---- Codex prompting (Path A) - OPTIONAL, leave commented for no prompts ----
# By default the Codex launcher runs with NO approval prompts (approval=never,
# full access). To get prompts back, uncomment and set these, or pass
# --auto-mode on the launcher for a middle ground (prompts only outside the
# workspace). See README "How prompting is controlled".
#CODEX_APPROVAL=on-request
#CODEX_SANDBOX=workspace-write
